# --- web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# En desarrollo la API sirve los assets locales en /assets; en producción, URL pública de R2
NEXT_PUBLIC_ASSETS_URL=http://localhost:8000/assets

# --- api (apps/api/.env) ---
# Usa ASSETS_DIR en desarrollo o ASSETS_URL (R2) en producción
ASSETS_DIR=../../data/regions
ASSETS_URL=
CORS_ORIGINS=http://localhost:3000

# --- pipeline ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wazemars-assets
